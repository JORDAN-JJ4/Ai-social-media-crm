# FB CRM Application Configurations

# Application settings
APP_NAME="Omni FB Analytics"
DEBUG=True
SECRET_KEY="your-super-secret-key"
# 32-byte url-safe base64-encoded Fernet key (e.g. generate via: cryptography.fernet.Fernet.generate_key().decode())
TOKEN_ENCRYPTION_KEY=""


# Database Configuration
# Default is sqlite:///./social_growth.db
DATABASE_URL="sqlite:///./social_growth.db"

# Facebook OAuth integration
FACEBOOK_APP_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:8000/api/auth/facebook/callback"

# LLM API Keys
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Scheduler setting (in minutes)
AUTONOMOUS_CYCLE_INTERVAL_MINUTES=60

# Vercel Cron Job authorization token (e.g. any high-entropy random key)
CRON_SECRET=""

# Development/Demo fallback toggle (set to true only for local simulation)
DEMO_MODE=false
